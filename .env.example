CLOUDCTL_ENV=development
CLOUDCTL_REPOSITORY_MODE=postgresql
CLOUDCTL_DATABASE_URL=postgresql+asyncpg://cloudctl:cloudctl@localhost:5432/cloudctl
# Development MinIO may use HTTP. Production requires S3 mode and an HTTPS endpoint
# whenever CLOUDCTL_S3_ENDPOINT is explicitly configured.
CLOUDCTL_OBJECT_STORE_MODE=s3
CLOUDCTL_S3_ENDPOINT=http://localhost:9000
CLOUDCTL_S3_BUCKET=cloudctl
CLOUDCTL_S3_REGION=us-east-1
CLOUDCTL_S3_ACCESS_KEY=cloudctl
CLOUDCTL_S3_SECRET_KEY=change-me
CLOUDCTL_MEDIA_UPLOAD_EXPIRES_SECONDS=900
CLOUDCTL_OIDC_ISSUER=http://localhost:8080/realms/cloudctl
CLOUDCTL_OIDC_AUDIENCE=cloudctl-api
# Development only. Production must set this to false and configure exactly one
# of CLOUDCTL_OIDC_JWKS_URL, CLOUDCTL_OIDC_PUBLIC_KEY_PEM, or CLOUDCTL_OIDC_PUBLIC_KEY_PATH.
CLOUDCTL_OIDC_JWKS_URL=http://localhost:8080/realms/cloudctl/protocol/openid-connect/certs
CLOUDCTL_OIDC_ALLOWED_ALGORITHMS=["RS256"]
CLOUDCTL_OIDC_JWKS_CACHE_SECONDS=300
CLOUDCTL_OIDC_CLOCK_SKEW_SECONDS=30
CLOUDCTL_OIDC_HTTP_TIMEOUT_SECONDS=5
CLOUDCTL_TEMPORAL_ADDRESS=localhost:7233
CLOUDCTL_EDGE_GRPC_BIND=0.0.0.0:7443
CLOUDCTL_DEV_AUTH_BYPASS=true
# Edge Gateway runs the incompatible LAMDA SDK in a dedicated Python 3.12 environment.
# Use an absolute path on the Edge host; do not point this at the control-plane environment.
# CLOUDCTL_LAMDA_SIDECAR_PYTHON=/opt/cloudctl/lamda-sidecar/bin/python
# Optional explicit service adapters. Keys must be approved Operations catalog keys;
# production endpoints must use HTTPS and require the Bearer token below.
# CLOUDCTL_OPERATION_EXECUTOR_URLS={"media.derivative.generate":"https://media-worker.example.test/v1/execute"}
# CLOUDCTL_OPERATION_EXECUTOR_BEARER_TOKEN=replace-with-service-token
CLOUDCTL_OPERATION_EXECUTOR_TIMEOUT_SECONDS=15
