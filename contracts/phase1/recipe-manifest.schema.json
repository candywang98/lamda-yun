{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudctl.example/contracts/phase1/recipe-manifest.schema.json",
  "title": "CloudCtl signed local Recipe package",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "manifest", "graph", "signature"],
  "properties": {
    "apiVersion": { "const": "cloudctl.recipe/v1" },
    "kind": { "const": "LocalRecipePackage" },
    "manifest": { "$ref": "#/$defs/manifest" },
    "graph": { "$ref": "#/$defs/graph" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "action": {
      "enum": ["tap", "input", "scroll", "extract", "wait", "launch", "media", "log", "checkpoint"]
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "hash",
        "signingKeyId",
        "minEngineVersion",
        "platform",
        "app",
        "commandTypes"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "hash": { "$ref": "#/$defs/sha256" },
        "signingKeyId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "minEngineVersion": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "platform": { "enum": ["xianyu", "xiaohongshu", "companion"] },
        "app": {
          "type": "string",
          "enum": ["com.taobao.idlefish", "com.xingin.xhs", "com.company.cloudctl.companion"]
        },
        "commandTypes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startStateId", "states", "maxIterations", "maxDurationMs"],
      "properties": {
        "startStateId": { "$ref": "#/$defs/id" },
        "maxIterations": { "type": "integer", "minimum": 1, "maximum": 200 },
        "maxDurationMs": { "type": "integer", "minimum": 1000, "maximum": 900000 },
        "safeCheckpoint": { "$ref": "#/$defs/id" },
        "resumeGuard": { "type": "string", "maxLength": 160 },
        "commitActionId": { "$ref": "#/$defs/id" },
        "states": {
          "type": "array",
          "minItems": 1,
          "maxItems": 80,
          "items": { "$ref": "#/$defs/state" }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stateId", "action", "onSuccess"],
      "properties": {
        "stateId": { "$ref": "#/$defs/id" },
        "entryGuard": { "type": "string", "maxLength": 160 },
        "action": { "$ref": "#/$defs/action" },
        "locatorRef": { "type": "string", "maxLength": 160 },
        "postcondition": { "type": "string", "maxLength": 160 },
        "onSuccess": { "$ref": "#/$defs/id" },
        "onFailure": { "$ref": "#/$defs/id" },
        "onPause": { "const": "WAITING_USER" },
        "terminal": { "type": "boolean" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "digest"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "keyId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "digest": { "type": "string", "minLength": 1 }
      }
    }
  }
}
