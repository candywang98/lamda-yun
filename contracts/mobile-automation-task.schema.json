{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudctl.example/contracts/mobile-automation-task.schema.json",
  "title": "CloudCtl mobile automation task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "taskId",
    "deviceId",
    "targetPackage",
    "issuedAt",
    "expiresAt",
    "maxRunSeconds",
    "steps"
  ],
  "properties": {
    "protocolVersion": { "const": "cloudctl.mobile/v1" },
    "taskId": { "$ref": "#/$defs/id" },
    "deviceId": { "$ref": "#/$defs/id" },
    "targetPackage": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)+$"
    },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "maxRunSeconds": { "type": "integer", "minimum": 1, "maximum": 1800 },
    "mediaDelivery": { "$ref": "#/$defs/mediaDelivery" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "mediaDelivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deliveryId", "assetIds"],
      "properties": {
        "deliveryId": { "$ref": "#/$defs/id" },
        "assetIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "locatorRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "baseStep": {
      "type": "object",
      "required": ["stepId", "action", "timeoutMs"],
      "properties": {
        "stepId": { "$ref": "#/$defs/id" },
        "action": { "type": "string" },
        "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 60000 }
      }
    },
    "step": {
      "oneOf": [
        { "$ref": "#/$defs/find" },
        { "$ref": "#/$defs/tap" },
        { "$ref": "#/$defs/input" },
        { "$ref": "#/$defs/wait" },
        { "$ref": "#/$defs/screenshot" },
        { "$ref": "#/$defs/assert" },
        { "$ref": "#/$defs/log" }
      ]
    },
    "find": {
      "allOf": [
        { "$ref": "#/$defs/baseStep" },
        {
          "additionalProperties": false,
          "required": ["stepId", "action", "timeoutMs", "locatorRef"],
          "properties": {
            "stepId": { "$ref": "#/$defs/id" },
            "action": { "const": "ui.find" },
            "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 60000 },
            "locatorRef": { "$ref": "#/$defs/locatorRef" }
          }
        }
      ]
    },
    "tap": {
      "allOf": [
        { "$ref": "#/$defs/baseStep" },
        {
          "additionalProperties": false,
          "required": [
            "stepId",
            "action",
            "timeoutMs",
            "locatorRef"
          ],
          "properties": {
            "stepId": { "$ref": "#/$defs/id" },
            "action": { "const": "ui.tap" },
            "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 60000 },
            "locatorRef": { "$ref": "#/$defs/locatorRef" },
            "postconditionLocatorRef": { "$ref": "#/$defs/locatorRef" }
          }
        }
      ]
    },
    "input": {
      "allOf": [
        { "$ref": "#/$defs/baseStep" },
        {
          "additionalProperties": false,
          "required": ["stepId", "action", "timeoutMs", "locatorRef", "value", "replace"],
          "properties": {
            "stepId": { "$ref": "#/$defs/id" },
            "action": { "const": "ui.input" },
            "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 60000 },
            "locatorRef": { "$ref": "#/$defs/locatorRef" },
            "value": { "type": "string", "maxLength": 1024, "pattern": "^[^\\u0000]*$" },
            "replace": { "const": true },
            "sensitive": { "type": "boolean", "default": false }
          }
        }
      ]
    },
    "wait": {
      "allOf": [
        { "$ref": "#/$defs/baseStep" },
        {
          "additionalProperties": false,
          "required": ["stepId", "action", "timeoutMs", "locatorRef", "condition", "pollMs"],
          "properties": {
            "stepId": { "$ref": "#/$defs/id" },
            "action": { "const": "ui.wait" },
            "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 60000 },
            "locatorRef": { "$ref": "#/$defs/locatorRef" },
            "condition": { "enum": ["EXISTS", "NOT_EXISTS", "ENABLED"] },
            "pollMs": { "type": "integer", "minimum": 100, "maximum": 2000 }
          }
        }
      ]
    },
    "screenshot": {
      "allOf": [
        { "$ref": "#/$defs/baseStep" },
        {
          "additionalProperties": false,
          "required": ["stepId", "action", "timeoutMs", "label"],
          "properties": {
            "stepId": { "$ref": "#/$defs/id" },
            "action": { "const": "ui.screenshot" },
            "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 60000 },
            "label": { "type": "string", "minLength": 1, "maxLength": 80 }
          }
        }
      ]
    },
    "assert": {
      "allOf": [
        { "$ref": "#/$defs/baseStep" },
        {
          "additionalProperties": false,
          "required": ["stepId", "action", "timeoutMs", "locatorRef", "predicate"],
          "properties": {
            "stepId": { "$ref": "#/$defs/id" },
            "action": { "const": "ui.assert" },
            "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 60000 },
            "locatorRef": { "$ref": "#/$defs/locatorRef" },
            "predicate": { "enum": ["EXISTS", "NOT_EXISTS", "ENABLED"] }
          }
        }
      ]
    },
    "log": {
      "allOf": [
        { "$ref": "#/$defs/baseStep" },
        {
          "additionalProperties": false,
          "required": ["stepId", "action", "timeoutMs", "level", "messageCode"],
          "properties": {
            "stepId": { "$ref": "#/$defs/id" },
            "action": { "const": "run.log" },
            "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 60000 },
            "level": { "enum": ["DEBUG", "INFO", "WARN", "ERROR"] },
            "messageCode": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Z0-9_]+$"
            }
          }
        }
      ]
    }
  }
}
